# rectile — copy to `.env` next to compose.yaml and fill in.
# compose reads this file automatically; nothing here is optional unless marked.

# Public hostname served by the Cloudflare Tunnel (informational — used in
# docs/examples, not read by the app).
DOMAIN=armadax.xyz

# Password for the bundled Postgres 16 container (user/db are both "rectile").
# Passed to the app as discrete POSTGRES_* vars, NOT inside a URL, so any
# characters (? & # …) are safe without percent-encoding.
POSTGRES_PASSWORD=change-me

# Bearer token guarding EVERYTHING under /api/* (REST API + MCP endpoint).
# Generate one:  openssl rand -hex 32
API_TOKEN=change-me

# Set to 1 to insert 3 demo projects on first boot (only when the DB is empty).
RECTILE_SEED_DEMO=0

# Connector token for the Cloudflare Tunnel (Zero Trust → Networks → Tunnels
# → your tunnel → Install connector; the long string after `--token`).
# The cloudflared compose service uses this to join the tunnel.
TUNNEL_TOKEN=paste-tunnel-token-here

# --- optional overrides -----------------------------------------------------
# Use a single connection string instead of the discrete POSTGRES_* vars
# (remember to percent-encode special characters in the password):
#DATABASE_URL=postgres://rectile:pass@db:5432/rectile

# Set to 0 to skip the automatic drizzle migration on app boot:
#RECTILE_MIGRATE_ON_BOOT=1
